{
  "name": "gems",
  "version": "0.4.1-beta.2",
  "description": "Game Engine Migration System — agent-orchestrated migration for game projects.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "gems": "./bin/gems.js"
  },
  "scripts": {
    "start": "node bin/gems.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:all": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:package": "node --test tests/package/gems-package.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html --reports-dir=coverage node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "validate:schemas": "node scripts/validate-all.js",
    "validate:agents": "node tools/validator/validator.js --type=agent",
    "validate:workflows": "node tools/validator/validator.js --type=workflow",
    "validate:modules": "node tools/validator/validator.js --type=module",
    "lint": "eslint . --max-warnings=0",
    "lint:md": "node scripts/lint-markdown.js",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run validate:schemas && npm run test:all && npm run test:package"
  },
  "keywords": [
    "game-development",
    "game-migration",
    "engine-migration",
    "unreal-engine",
    "ue5",
    "godot",
    "godot-4",
    "unity",
    "unity-6",
    "ai-agents",
    "multi-agent",
    "codex",
    "llm",
    "workflow",
    "framework",
    "gamedev",
    "indie-game",
    "game-dev-tools",
    "re-g3x",
    "research"
  ],
  "author": "Murilo Moro",
  "contributors": [
    {
      "name": "RE-G3X",
      "url": "https://re-g3x.github.io/homepage/"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoArthur/gd-ms.git"
  },
  "bugs": {
    "url": "https://github.com/EduardoArthur/gd-ms/issues"
  },
  "homepage": "https://github.com/EduardoArthur/gd-ms#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/gems.js",
    "src/index.js",
    "src/version.js",
    "src/cli/gems.js",
    "src/cli/commands/gems-install.js",
    "src/cli/commands/gems-migration.js",
    "src/gems/",
    "src/core/engines/engine-profile-manager.js",
    "src/modules/engines/*/engine-profile.yaml",
    "tools/installer/index.js",
    "tools/installer/lib/",
    "tools/validator/validator.js",
    "tools/validator/schema/",
    "docs/NPM-PUBLISH-GUIDE.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "inquirer": "^9.3.7",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chalk": "^5.3.0",
    "eslint": "^9.15.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.1.0",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  }
}
